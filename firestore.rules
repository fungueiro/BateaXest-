rules_version = '2';

// El cuaderno vive en un único documento compartido, cuaderno/estado, así que la
// separación no la hace la app: la hace esta regla. `request.auth != null` NO basta:
// la API de registro de Firebase es pública y la clave del proyecto va en el HTML,
// así que cualquiera puede crearse una cuenta y cumplir esa condición.
//
// Se ata al UID en vez de al email: el repo es público y así no queda ahí ninguna
// dirección. Para dar acceso a alguien más, se añade su UID a la lista.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null && request.auth.uid in [
        // Consola de Firebase → Authentication → Users → "Identificador de usuario"
        "PON_AQUI_TU_UID"
      ];
    }

    match /cuaderno/{doc} {
      allow read, write: if autorizado();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
